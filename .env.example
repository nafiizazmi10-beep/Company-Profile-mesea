# Environment Variables Template
# Buat salinan file ini menjadi .env.local untuk development

# Google Apps Script Web App Deployment URL
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Secret Token untuk otorisasi antara Next.js dan Apps Script
APPS_SCRIPT_SECRET=your_super_secret_token_here

# Secret untuk enkripsi sesi / JWT cookie
AUTH_SECRET=your_auth_secret_key_change_in_production

